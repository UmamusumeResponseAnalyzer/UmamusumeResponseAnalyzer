<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.15.0.0</Version>
		<PackageId>UmamusumeResponseAnalyzer</PackageId>
		<PackageVersion>2026.9.26</PackageVersion>
		<Description>UmamusumeResponseAnalyzer plugin compile-time API.</Description>
		<Authors>EtherealAO</Authors>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Platforms>AnyCPU;x64</Platforms>
		<TrimMode>partial</TrimMode>
		<CETCompat>false</CETCompat>
		<NoWarn>1701;1702;CS8509;CS8618;CA2211;NU5131</NoWarn>
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(IntermediateOutputPath)ref\$(AssemblyName).dll"
		      Pack="true"
		      PackagePath="ref\$(TargetFramework)\" />
		<None Include="..\eng\URA.Plugin.Build.props"
		      Pack="true"
		      PackagePath="buildTransitive\UmamusumeResponseAnalyzer.props" />
		<None Include="..\eng\URA.Plugin.Build.targets"
		      Pack="true"
		      PackagePath="buildTransitive\UmamusumeResponseAnalyzer.targets" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="UmamusumeResponseAnalyzer.Tests" />
		<InternalsVisibleTo Include="AIRedirectorSmoke" />
		<InternalsVisibleTo Include="LegendScenarioAnalyzerSmoke" />
		<InternalsVisibleTo Include="PluginReplaySmoke" />
		<InternalsVisibleTo Include="PluginRuntimeSmoke" />
		<InternalsVisibleTo Include="PluginSmokeTests" />
		<InternalsVisibleTo Include="PluginWorkspaceLifecycleSmoke" />
		<InternalsVisibleTo Include="RamenScenarioAnalyzerSmoke" />
		<InternalsVisibleTo Include="SendGameStatusPluginSmoke" />
		<InternalsVisibleTo Include="SkillEffectPluginSmoke" />
		<InternalsVisibleTo Include="SkillTipsResponseAnalyzerSmoke" />
		<InternalsVisibleTo Include="WinSaddleAnalyzerSmoke" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Terminal.Gui" Version="2.4.17" />
		<PackageReference Include="Watson.Lite" Version="6.6.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<Target Name="DisableMessagePackSourceGenerator" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="'%(FileName)%(Extension)' == 'MessagePack.SourceGenerator.dll'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Compile Update="Localization\PluginRegistry.Designer.cs">
		  <DependentUpon>PluginRegistry.resx</DependentUpon>
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		</Compile>
		<Compile Update="Localization\TerminalGui.Designer.cs">
		  <DependentUpon>TerminalGui.resx</DependentUpon>
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		</Compile>
		<Compile Update="Localization\Dmm.Designer.cs">
		  <DependentUpon>Dmm.resx</DependentUpon>
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		</Compile>
		<Compile Update="Localization\CommandInfo\Cook.Designer.cs">
		  <DependentUpon>Cook.resx</DependentUpon>
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		</Compile>
		<Compile Update="Localization\CommandInfo\UAF.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>UAF.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\Config.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Config.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\Database.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Database.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\Game.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Game.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\LaunchMenu.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>LaunchMenu.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\NameManager.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>NameManager.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\ResourceUpdater.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>ResourceUpdater.resx</DependentUpon>
		</Compile>
		<Compile Update="Localization\Server.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Server.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Localization\PluginRegistry.resx">
		  <LastGenOutput>PluginRegistry.Designer.cs</LastGenOutput>
		  <Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\TerminalGui.resx">
		  <LastGenOutput>TerminalGui.Designer.cs</LastGenOutput>
		  <Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\CommandInfo\Cook.resx">
		  <LastGenOutput>Cook.Designer.cs</LastGenOutput>
		  <Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\CommandInfo\UAF.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>UAF.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Config.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>Config.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Database.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>Database.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Database.zh-CN.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Game.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		  <LastGenOutput>Game.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Dmm.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>Dmm.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\LaunchMenu.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>LaunchMenu.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\NameManager.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>NameManager.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\ResourceUpdater.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>ResourceUpdater.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\Server.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>Server.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
