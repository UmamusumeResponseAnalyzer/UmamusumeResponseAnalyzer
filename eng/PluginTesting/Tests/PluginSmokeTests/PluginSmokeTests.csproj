<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsUraPlugin>false</IsUraPlugin>
    <GenerateUraPluginManifestOnBuild>false</GenerateUraPluginManifestOnBuild>
    <PackageUraPluginOnBuild>false</PackageUraPluginOnBuild>
    <DeployUraPluginToLocalAppDataOnBuild>false</DeployUraPluginToLocalAppDataOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\RandomDtoGenerator.cs" Link="RandomDtoGenerator.cs" />
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\RandomDtoFactory.cs" Link="RandomDtoFactory.cs" />
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\SmokeHost.cs" Link="WorkspaceSmokeSession.cs" />
    <ProjectReference Include="$(UraTestHostRoot)\UmamusumeResponseAnalyzer\UmamusumeResponseAnalyzer.csproj" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\AIRedirector\AIRedirector.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\EventResponseAnalyzer\EventResponseAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\GamePacketCollector\GamePacketCollector.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\SendGameStatusPlugin\SendGameStatusPlugin.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
  </ItemGroup>

</Project>
