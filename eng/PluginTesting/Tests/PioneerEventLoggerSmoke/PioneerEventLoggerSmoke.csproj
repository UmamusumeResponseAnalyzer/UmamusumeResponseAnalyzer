<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsUraPlugin>false</IsUraPlugin>
    <GenerateUraPluginManifestOnBuild>false</GenerateUraPluginManifestOnBuild>
    <PackageUraPluginOnBuild>false</PackageUraPluginOnBuild>
    <DeployUraPluginToLocalAppDataOnBuild>false</DeployUraPluginToLocalAppDataOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\SmokeHost.cs" Link="SmokeHost.cs" />
    <Compile Include="$(UraTestPluginSourcesRoot)\EventLoggerPlugin\deps\PioneerScenarioAnalyzer\tests\PioneerScenarioAnalyzerSmoke\Fixtures.cs" Link="Fixtures.cs" />
    <ProjectReference Include="$(UraTestHostRoot)\UmamusumeResponseAnalyzer\UmamusumeResponseAnalyzer.csproj" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\EventLoggerPlugin\deps\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\EventLoggerPlugin\EventLoggerPlugin.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
  </ItemGroup>
</Project>
